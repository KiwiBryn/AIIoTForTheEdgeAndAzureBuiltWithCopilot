{
  "version": "2.0",
  "concurrency": {
    "maxConcurrentRequests": 5
  },
  "logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore-": "Warning",
      "Microsoft.AspNetCore": "Trace"
    },
    "applicationInsights": {
      "LogLevel": {
        "Default": "Trace"
      },
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  },
  "ApplicationInsights": {
    "DevelopmentMode": "AlwaysOn"
  }
}